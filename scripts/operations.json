{
  "_note": "Derived from https://crossly.net/openapi/seller.json (paths, params, responses) and https://crossly.net/docs/api-*.md (request bodies the spec does not model). Base URL https://crossly.net/api.",
  "platforms": ["poshmark", "mercari", "depop", "grailed", "vinted", "whatnot", "vestiaire", "offerup", "facebook", "ebay", "etsy", "shopify", "amazon", "walmart", "curtsy"],
  "operations": [
    { "key": "me.get", "resource": "Account", "name": "Get Account", "method": "GET", "path": "/v1/me", "operationId": "getMe", "scope": null,
      "summary": "Identity check: authenticated user, PAT scopes and plan." },

    { "key": "listing.list", "resource": "Listing", "name": "List Listings", "method": "GET", "path": "/v1/listings", "operationId": "listListings", "scope": "listings:read", "paginated": true, "totals": false,
      "summary": "List listings.",
      "query": { "platform": "string", "status": "string", "sku": "string", "tag": "string", "updatedSince": "date-time", "stillLive": "boolean" } },
    { "key": "listing.get", "resource": "Listing", "name": "Get Listing", "method": "GET", "path": "/v1/listings/{id}", "operationId": "getListing", "scope": "listings:read",
      "summary": "Get one listing with its platform rows." },
    { "key": "listing.create", "resource": "Listing", "name": "Create Listing (Crosspost)", "method": "POST", "path": "/v1/listings", "operationId": "createListing", "scope": "listings:write", "idempotent": true,
      "summary": "Create a listing and fan out crosspost jobs across platforms.",
      "body": { "platforms": "string[] (required, 1-15)", "inventoryItemId": "uuid", "data": "object (required): title, description, price, images[], condition, brand, size, sku, weightLb, weightOz, platformOverrides", "createInventoryItem": "boolean", "clientReferenceId": "string <=100" } },
    { "key": "listing.update", "resource": "Listing", "name": "Update Listing", "method": "PATCH", "path": "/v1/listings/{id}", "operationId": "updateListing", "scope": "listings:write",
      "summary": "Edit a listing and push the change to its live platform copies.",
      "body": { "changes": "object (required): price, title, description, ...", "platforms": "string[] (omit = everywhere live)" } },
    { "key": "listing.delist", "resource": "Listing", "name": "Delist Listing", "method": "DELETE", "path": "/v1/listings/{id}", "operationId": "deleteListing", "scope": "listings:write",
      "summary": "Delist a listing, optionally only on some platforms.",
      "query": { "platforms": "comma-separated string" } },

    { "key": "inventory.list", "resource": "Inventory", "name": "List Inventory", "method": "GET", "path": "/v1/inventory", "operationId": "listInventory", "scope": "inventory:read", "paginated": true, "totals": true,
      "summary": "List inventory items.",
      "query": { "status": "active|sold|archived", "sku": "string", "platforms": "comma-separated string", "platformMode": "listed|not_listed", "updatedSince": "date-time" } },
    { "key": "inventory.get", "resource": "Inventory", "name": "Get Inventory Item", "method": "GET", "path": "/v1/inventory/{id}", "operationId": "getInventory", "scope": "inventory:read",
      "summary": "Get one inventory item with its platform listings." },
    { "key": "inventory.create", "resource": "Inventory", "name": "Create Inventory Item", "method": "POST", "path": "/v1/inventory", "operationId": "createInventory", "scope": "inventory:write", "idempotent": true,
      "summary": "Create an inventory item.",
      "body": { "defaultTitle": "string 1-140 (required)", "defaultDescription": "string", "defaultPrice": "number|decimal string", "originalPrice": "number|decimal string", "brand": "string", "size": "string", "condition": "new_with_tags|new_without_tags|like_new|good_used|fair", "color": "string[]", "tags": "string[]", "sku": "string", "quantity": "integer", "images": "string[]", "notes": "string" } },
    { "key": "inventory.update", "resource": "Inventory", "name": "Update Inventory Item", "method": "PATCH", "path": "/v1/inventory/{id}", "operationId": "updateInventory", "scope": "inventory:write",
      "summary": "Partially update an inventory item (does not push to live listings).",
      "body": { "...": "any create field" } },
    { "key": "inventory.setQuantity", "resource": "Inventory", "name": "Set Stock", "method": "POST", "path": "/v1/inventory/bulk-quantity", "operationId": "createInventoryBulkQuantity", "scope": "inventory:write",
      "summary": "Set / increase / decrease available stock for one or many items; live listings follow.",
      "body": { "ids": "uuid[]", "mode": "set|increase|decrease", "value": "integer", "items": "[{id, quantity}] (mode=set only, 1-5000)", "syncMarketplaces": "boolean" } },

    { "key": "order.list", "resource": "Order", "name": "List Orders", "method": "GET", "path": "/v1/orders", "operationId": "listOrders", "scope": "orders:read", "paginated": true, "totals": false,
      "summary": "List orders with sale price, fees, SKU and line items.",
      "query": { "status": "string (needs_fulfillment, shipped, delivered, refunded, disputed, ...)", "platform": "string", "channel": "retail|wholesale|auction|live|world|pos|rental", "updatedSince": "date-time" } },
    { "key": "order.get", "resource": "Order", "name": "Get Order", "method": "GET", "path": "/v1/orders/{id}", "operationId": "getOrder", "scope": "orders:read",
      "summary": "Get one order." },
    { "key": "order.update", "resource": "Order", "name": "Update Order", "method": "PATCH", "path": "/v1/orders/{id}", "operationId": "updateOrder", "scope": "orders:write",
      "summary": "Update an order's status or notes.",
      "body": { "status": "string", "notes": "string" } },
    { "key": "order.addTracking", "resource": "Order", "name": "Add Tracking", "method": "POST", "path": "/v1/orders/{id}/tracking", "operationId": "createOrderTracking", "scope": "orders:write",
      "summary": "Submit tracking number + carrier and notify the marketplace.",
      "body": { "trackingNumber": "string (required)", "carrier": "string (usps, ups, fedex, ...)", "trackingUrl": "string" } },

    { "key": "sale.list", "resource": "Sale", "name": "List Sales", "method": "GET", "path": "/v1/sales", "operationId": "listSales", "scope": "sales:read", "paginated": true, "totals": false,
      "summary": "List sales, newest first by detectedAt." },

    { "key": "offer.list", "resource": "Offer", "name": "List Offers", "method": "GET", "path": "/v1/offers", "operationId": "getOffer", "scope": null, "listKey": "offers",
      "summary": "List buyer offers on your Crossly marketplace listings (incl. bundles).",
      "query": { "status": "pending|accepted|declined|countered|expired|withdrawn", "limit": "integer" } },
    { "key": "offer.respond", "resource": "Offer", "name": "Respond to Offer", "method": "POST", "path": "/v1/offers/{id}/respond", "operationId": "createOfferRespond", "scope": null,
      "summary": "Accept, decline or counter a Crossly marketplace offer.",
      "body": { "action": "accept|decline|counter (required)", "counterCents": "integer (counter only)" } },

    { "key": "webhook.list", "resource": "Webhook", "name": "List Webhooks", "method": "GET", "path": "/v1/webhooks", "operationId": "listWebhooks", "scope": "webhooks:read", "internal": true },
    { "key": "webhook.create", "resource": "Webhook", "name": "Create Webhook", "method": "POST", "path": "/v1/webhooks", "operationId": "createWebhook", "scope": "webhooks:write", "internal": true,
      "body": { "url": "https URL (required)", "events": "string[] ([] = all)", "description": "string <=500" } },
    { "key": "webhook.delete", "resource": "Webhook", "name": "Delete Webhook", "method": "DELETE", "path": "/v1/webhooks/{id}", "operationId": "deleteWebhook", "scope": "webhooks:write", "internal": true }
  ]
}
